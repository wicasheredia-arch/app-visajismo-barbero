# Plantilla de variables de entorno -- NUNCA completar este archivo
# con valores reales ni commitear un .env real. En produccion estas
# variables se inyectan desde Cloud Run + Secret Manager.

# Auth key de Gemini (no una clave "estandar" -- ver docs/INTEGRACION_NANO_BANANA_PRO.md)
GEMINI_AUTH_KEY=

# Dominio exacto desde el que GitHub Pages sirve VISAGE (sin barra final)
ALLOWED_ORIGIN=https://wicasheredia-arch.github.io

# Puerto local (Cloud Run lo asigna automaticamente en produccion)
PORT=8080
